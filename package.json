{
  "name": "fewer",
  "version": "0.7.1",
  "private": true,
  "description": "Interactive File & System Graph Visualizer",
  "author": "qvesera",
  "license": "AGPLv3",
  "repository": {
    "type": "git",
    "url": "https://github.com/qvesera/fewer.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/qvesera"
  },
  "scripts": {
    "dev": "bun next dev -p 3000 2>&1 | tee dev.log",
    "build": "bun next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "bun eslint .",
    "test": "bun test src && bun run test:components",
    "test:components": "bun test --preload ./tests/setup-dom.ts ./tests/components",
    "build:netlify": "bun next build",
    "env": "bun run scripts/env-sync.ts",
    "env:check": "bun run scripts/env-sync.ts check",
    "migrations:verify": "python3 scripts/migrations.py verify",
    "migrations:baseline": "python3 scripts/migrations.py baseline",
    "task:status": "python3 scripts/tasks.py status",
    "task:report": "python3 scripts/tasks.py report",
    "task:validate": "python3 scripts/tasks.py validate",
    "task:doctor": "python3 scripts/tasks.py doctor",
    "task:find": "python3 scripts/tasks.py find",
    "task:add": "python3 scripts/tasks.py add",
    "task:triage": "python3 scripts/tasks.py triage",
    "task:start": "python3 scripts/tasks.py start",
    "task:stop": "python3 scripts/tasks.py stop",
    "task:track": "python3 scripts/tasks.py track",
    "task:attach": "python3 scripts/tasks.py attach",
    "task:intake": "python3 scripts/tasks.py intake",
    "task:gh-sync": "python3 scripts/tasks.py gh-sync",
    "task:hooks": "python3 scripts/tasks.py install-hooks",
    "prepare": "python3 scripts/tasks.py install-hooks || echo 'task-tracking: hooks not installed (python3 missing?)'",
    "email:templates": "bun run scripts/gen-email-templates.ts",
    "gallery:seed": "bun run scripts/seed-gallery.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-popper": "^1.3.7",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "lz-string": "^1.5.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "open-color": "^1.9.1",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.6",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@netlify/plugin-nextjs": "^5.11.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}

# Client-side: Web3Forms access key
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_KEY_HERE

# Supabase (accounts, saved graphs, crawl cache, server-backed share links)
# Optional: the app works without these, but accounts/saved-graphs/sharing need them.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Resend (email invite links for invite-only sharing + nightly change digests)
# Optional: invite-only sharing falls back to a copyable link if unset.
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=fewer <onboarding@resend.dev>

# Supabase service role key (nightly watched-index digest job + account deletion).
# NEVER expose this to the client. Required for /api/watch/run to read all
# users' watchlists across RLS, and by DELETE /api/account to remove the
# signed-in user's owned shared graphs and delete the auth user.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Secret shared between the Netlify scheduled function and /api/watch/run.
# The scheduled function sends this in the x-cron-secret header.
CRON_SECRET=YOUR_CRON_SECRET

# Public app origin (used in emailed invite links + scheduled function target).
# Production: https://app.fewer.directory (the homepage lives at fewer.directory)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public marketing homepage origin (the GlobalNavbar "home" link target).
# Production: https://fewer.directory ; leave empty in dev to fall back to "/".
NEXT_PUBLIC_HOME_URL=https://fewer.directory

# ── Cloud Connections (OAuth account linking) ──────────────────────────────
# Encryption key for OAuth tokens at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
CONNECTIONS_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY

# GitHub OAuth App (private repo browsing). Redirect URI:
#   http://localhost:3000/api/cloud/callback  (dev)
#   https://app.fewer.directory/api/cloud/callback (prod)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Google OAuth (Google Drive). Redirect URI: same /api/cloud/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Microsoft Azure AD app (OneDrive, SharePoint, Azure DevOps, Azure Blob).
# Redirect URI: same /api/cloud/callback
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
# Common = personal MS accounts + org; or a specific tenant id.
MICROSOFT_TENANT=common
# Storage account name for Azure Blob connections (optional; can be set per connection)
AZURE_BLOB_STORAGE_ACCOUNT=YOUR_STORAGE_ACCOUNT

# ── Stripe billing (Pro subscriptions) ──────────────────────────────────────
# PAYMENT GATEWAY FEATURE FLAG. Keep OFF by default: while off, all
# /api/billing/* routes return 503 and the client hides upgrade UI. Account
# plans are assigned directly in the database (profiles.plan) — see
# content/docs/plans.md for the operator SQL. Flip both to true to enable
# self-serve Stripe checkout/portal/webhook.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
# Required (and only checked) once BILLING_ENABLED=true:
# Optional: /api/billing/* routes return 503 until these are set.
# Use test-mode values (sk_test_ / whsec_ from `stripe listen`) in dev;
# live keys live only in production env.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# Publishable key — optional, currently unused (all Stripe calls are server-side).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
# Signing secret for POST /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
# Recurring monthly price ID of the "fewer Pro" product (price_...).
STRIPE_PRO_PRICE_ID=YOUR_STRIPE_PRO_PRICE_ID
